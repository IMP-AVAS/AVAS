   },
   "source": [
    "z1 = 0.20891112354544225\n",
    "t1 = 1.26411341160931e-08\n",
    "\n",
    "z2 = 0.21088825211952822\n",
    "t2 = 1.2764211039170023e-08\n",
    "\n",
    "target_z = 0.21\n",
    "\n",
    "# 线性插值\n",
    "t = t1 + (target_z-z1)/(z2-z1)*(t2-t1)\n",
    "\n",
    "print(\"time =\", t, \"s\")\n",
    "\n",
    "# 转相位\n",
    "freq = 162.5e6  # Hz\n",
    "phase = 360 * freq * t\n",
    "\n",
    "\n",
    "print(\"phase =\", phase, \"deg\")"
   ],
   "outputs": [
    {
